{
  "$id": "fixture://schemas/fixture-copy-result.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "object_id": {"minLength": 1, "type": "string"},
    "relative_locators": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true}
  },
  "required": ["object_id", "relative_locators", "content_digest"],
  "type": "object"
}
