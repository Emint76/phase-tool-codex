{
  "$id": "https://phase-tool.local/schemas/file-create-candidate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "idempotency_key": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "input_binding": {
      "const": "payload"
    },
    "operation_id": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "target_locator": {
      "maxLength": 1024,
      "minLength": 1,
      "not": {
        "pattern": "(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.[A-Za-z0-9_.-]+)?(?:/|$)"
      },
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?(?:/[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?)*$",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "target_locator",
    "input_binding",
    "idempotency_key"
  ],
  "title": "File Create Candidate v1",
  "type": "object"
}
