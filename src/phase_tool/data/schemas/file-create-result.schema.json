{
  "$id": "https://phase-tool.local/schemas/file-create-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "length": {
      "minimum": 0,
      "type": "integer"
    },
    "locator": {
      "maxLength": 1024,
      "minLength": 1,
      "not": {
        "pattern": "(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.[A-Za-z0-9_.-]+)?(?:/|$)"
      },
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?(?:/[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?)*$",
      "type": "string"
    }
  },
  "required": [
    "locator",
    "digest",
    "length"
  ],
  "title": "File Create Result v1",
  "type": "object"
}
