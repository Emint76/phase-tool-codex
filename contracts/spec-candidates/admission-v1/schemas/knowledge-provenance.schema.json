{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phase-tool.local/spec-candidates/admission-v1/schemas/knowledge-provenance.schema.json",
  "title": "Knowledge provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance_version",
    "source_bindings",
    "producer",
    "transformation"
  ],
  "properties": {
    "provenance_version": {
      "const": "1.0"
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "source-result-binding.schema.json"
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifier",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "adapter",
            "operator",
            "system",
            "tool"
          ]
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "version",
        "parameters_digest"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "parameters_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        }
      }
    }
  }
}
