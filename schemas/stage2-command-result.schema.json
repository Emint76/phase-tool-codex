{
  "$id": "https://phase-tool.local/schemas/stage2-command-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "stage2_command_result_version": {"const": "1.0"},
    "command": {"enum": ["validate", "plan", "inspect", "execute"]},
    "success": {"type": "boolean"},
    "run_id": {"oneOf": [{"type": "null"}, {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "type": "string"}]},
    "terminal_status": {"oneOf": [{"type": "null"}, {"enum": ["rejected", "aborted", "validated_planned", "failed_no_effect", "failed_partial", "committed_unverified", "indeterminate", "succeeded_verified"]}]},
    "execution_disposition": {"oneOf": [{"type": "null"}, {"enum": ["not_executed", "executed", "reused_existing"]}]},
    "mutation_attempted": {"const": false},
    "effect_plan_digest": {"oneOf": [{"type": "null"}, {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}]},
    "intent_digest": {"oneOf": [{"type": "null"}, {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}]},
    "receipt_digest": {"oneOf": [{"type": "null"}, {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}]},
    "blockers": {"items": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$", "type": "string"}, "type": "array", "uniqueItems": true},
    "error": {"oneOf": [{"type": "null"}, {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$", "type": "string"}]},
    "exit_code": {"maximum": 255, "minimum": 0, "type": "integer"}
  },
  "required": ["stage2_command_result_version", "command", "success", "run_id", "terminal_status", "execution_disposition", "mutation_attempted", "effect_plan_digest", "intent_digest", "receipt_digest", "blockers", "error", "exit_code"],
  "title": "Phase Tool Stage 2 command result",
  "type": "object"
}
